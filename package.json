{
  "name": "see-me-see-u",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @smu/app",
    "dev:slow": "SLOW_FAKE=1 npm run dev -w @smu/app",
    "build": "npm run build -w @smu/app",
    "kiosk": "npm run build && SLOW_ENABLE=1 ARCHIVE_FILE=\"${ARCHIVE_FILE:-$PWD/archive/visits.jsonl}\" npm run preview -w @smu/app -- --host 127.0.0.1 --open \"/?kiosk=1&preview=on\"",
    "kiosk:fake": "npm run build && SLOW_ENABLE=1 SLOW_FAKE=1 ARCHIVE_FILE=\"${ARCHIVE_FILE:-$PWD/archive/visits.jsonl}\" npm run preview -w @smu/app -- --host 127.0.0.1 --open \"/?kiosk=1&preview=on\"",
    "archive:read": "node packages/archive/src/read-cli.ts",
    "selftest": "npm run build && npm run preview -w @smu/app -- --open \"/?selftest=1\"",
    "test": "npm run test -w @smu/core && npm run test -w @smu/app",
    "factory:balance": "node --env-file=.env packages/factory/src/cli.ts balance",
    "factory:plan": "node --env-file=.env packages/factory/src/cli.ts plan",
    "factory:generate": "node --env-file=.env packages/factory/src/cli.ts generate",
    "factory:normalize": "node --env-file=.env packages/factory/src/cli.ts normalize",
    "factory:compress": "node packages/factory/src/cli.ts compress",
    "factory:refs": "node packages/factory/src/cli.ts refs",
    "factory:index": "node --env-file=.env packages/factory/src/cli.ts index",
    "seo:indexnow": "node scripts/indexnow-submit.mjs",
    "factory:serve": "node --env-file=.env packages/factory/src/proxy.ts",
    "check": "npm run typecheck && npm run test && npm run check:parts",
    "typecheck": "tsc -p tsconfig.json",
    "check:parts": "node packages/factory/src/check-parts.ts",
    "doctor": "node packages/factory/src/doctor.ts",
    "factory:curate": "node --env-file=.env packages/factory/src/cli.ts curate",
    "factory:roster": "node --env-file=.env packages/factory/src/cli.ts roster"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2"
  }
}
